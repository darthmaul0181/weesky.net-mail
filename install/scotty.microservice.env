# Settings for the Scotty webmail API.
#
# Copy to /etc/scotty/scotty.microservice.env (install/README.md, step 3), then change the lines
# marked CHANGE. It holds a database password and a signing key: keep it readable by root and the
# scotty group only, and never commit a filled-in copy.
#
# After any change: systemctl restart scotty.microservice


# --- CHANGE: the database password you chose in step 2 -------------------------------------------
ConnectionStrings__WebmailPreferencesDatabase=Server=127.0.0.1;Port=3306;Database=scotty_webmail;User=scotty_webmail;Password=CHANGE_ME;

# --- CHANGE: a long random value that signs users' sessions --------------------------------------
# Generate one with:  openssl rand -base64 48
TokenConstants__Key=CHANGE_ME

# --- CHANGE: the web interface's address ---------------------------------------------------------
Cors__AllowedOrigins__0=https://mail.example.net

# --- CHANGE: your mail service: the IMAP server, the SMTP server, the ManageSieve server ---------
# Ports default to 143 (IMAP) and 587 (SMTP), with STARTTLS: see step 3 of install/README.md.
Mail__ImapHost=imap.example.net
Mail__SmtpHost=smtp.example.net
Sieve__Host=imap.example.net


# --- Leave as is ---------------------------------------------------------------------------------

# Where the service listens. Your web server passes requests to it here.
ASPNETCORE_URLS=http://127.0.0.1:5000
ASPNETCORE_ENVIRONMENT=Production

# The address your web server connects from. The service only trusts the visitor's address
# reported by the machines listed here.
ForwardedHeaders__KnownProxies__0=127.0.0.1

# Works with any IMAP and SMTP service. The other platform, weesky, is described in
# "Two platforms" in install/README.md.
Platform=generic


# --- Optional ------------------------------------------------------------------------------------

# Sync contacts and calendars with phones: the API's address.
# Dav__PublicUrl=https://api.example.net
