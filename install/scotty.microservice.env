# Example EnvironmentFile for the Scotty webmail backend.
#
# Copy to /etc/scotty/scotty.microservice.env, owned by root, mode 0600: it
# holds the database password and the JWT signing key. Never commit a filled-in
# copy of this file.
#
# A double underscore is .NET's separator for a nested configuration key:
# ConnectionStrings__WebmailPreferencesDatabase is ConnectionStrings:...

# --- Required. The service refuses to start without any of these -------------

# The webmail's own database, created by install.sql.
ConnectionStrings__WebmailPreferencesDatabase=Server=127.0.0.1;Port=3306;Database=scotty_webmail;User=scotty_webmail;Password=CHANGE_ME;

# The JWT signing key: at least 32 bytes. Generate one and never reuse it —
# openssl rand -base64 48
TokenConstants__Key=CHANGE_ME

# The origin the web interface is served from. Additional origins are
# Cors__AllowedOrigins__1, __2, and so on.
Cors__AllowedOrigins__0=https://account.mail.example.net

# Which platform answers for accounts and admin rights. Two values:
#   weesky  - a Dovecot database backs the accounts, aliases and domains, and
#             the Administration screens manage them
#   generic - any IMAP server; nothing behind the mailbox, so no directory to
#             administer and those screens are absent
Platform=generic

# The address the reverse proxy connects FROM. Without it the login rate
# limiter partitions every caller into one shared bucket, and five failed
# attempts from anybody lock out every user. Add __1=::1 if Kestrel listens on
# the IPv6 loopback.
ForwardedHeaders__KnownProxies__0=127.0.0.1

# --- Where the service listens, behind the proxy -----------------------------

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# --- Your mail server --------------------------------------------------------
# These override the defaults in appsettings.json.

Mail__ImapHost=mail.example.net
Mail__SmtpHost=mail.example.net
Sieve__Host=mail.example.net

# --- Optional ----------------------------------------------------------------

# CardDAV and CalDAV. The bare origin the reverse proxy serves: no path, no
# trailing slash, no port. Left empty, the Sync tab simply does not appear and
# nothing says so at startup.
# Dav__PublicUrl=https://api.mail.example.net

# Connecting external mailboxes over OAuth — see optional/oauth-providers.md.
# Mail__WebmailBaseUrl=https://account.mail.example.net
# Mail__OAuthRedirectUri=https://api.mail.example.net/api/ConnectedAccounts/OAuth/Callback

# --- Only when Platform=weesky ------------------------------------------------
# The whole block is then required, and the service fails at startup naming the
# key it is missing.

# Weesky__ConnectionStrings__MailUserAccountsDatabase=Server=127.0.0.1;Port=3306;Database=dovecot;User=...;Password=...;
# Weesky__Dovecot__ApiUrl=http://mail.example.net:8080/doveadm/v1
# Weesky__Dovecot__ApiKey=CHANGE_ME
