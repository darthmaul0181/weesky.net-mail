# The Scotty webmail API, run by systemd.
#
# Copy to /etc/systemd/system/scotty.microservice.service (install/README.md, step 3).
# It works as is with the paths the guide uses.

[Unit]
Description=Scotty webmail
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
# Not Type=notify: the service sends systemd no readiness signal, so systemd would wait for
# one that never comes and give up.
Type=exec

User=scotty
Group=scotty
WorkingDirectory=/opt/scotty
ExecStart=/opt/scotty/scotty.microservice
EnvironmentFile=/etc/scotty/scotty.microservice.env

# systemd creates these two folders for the service: /var/lib/scotty.microservice holds the keys
# that protect sign-in cookies, /var/log/scotty.microservice holds the logs.
# Without the first line the service refuses to start; without the second it cannot write its logs.
StateDirectory=scotty.microservice
StateDirectoryMode=0700
LogsDirectory=scotty.microservice

# If the service stops, start it again a minute later.
Restart=always
RestartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
