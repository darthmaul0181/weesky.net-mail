{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MailUserAccountsDatabase": "",
    "WebmailPreferencesDatabase": ""
  },
  "TokenConstants": {
    "Issuer": "weesky.net.Snoopy.Microservice",
    "Audience": "weesky.net.Snoopy.Microservice",
    "ExpiryInMinutes": 30,
    "Key": "",
    "AuthCookieName": "BearerAuth"
  },
  "Cors": {
    "AllowedOrigins": [ "https://account.mail.weesky.net" ]
  },
  "Dovecot": {
    "ApiUrl": "http://mail.weesky.net:8080/doveadm/v1",
    "ApiKey": ""
  },
  "Sieve": {
    "Host": "mail.weesky.net",
    "Port": 4190,
    "MasterUser": "",
    "MasterPassword": "",
    "ScriptName": "weesky-rules",
    "TimeoutSeconds": 10,
    "AllowInvalidCertificate": false
  },
  "Mail": {
    "ImapHost": "mail.weesky.net",
    "ImapPort": 143,
    "ImapSecurity": "StartTls",
    "SmtpHost": "mail.weesky.net",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls",
    "TimeoutSeconds": 30,
    "AllowInvalidCertificate": false
  },
  "AllowedHosts": "*"
}
