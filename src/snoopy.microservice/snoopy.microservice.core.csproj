<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>weesky.Snoopy.Microservice</RootNamespace>
    <!-- Swagger reads ApiDocumentation.xml at startup, so generate it in every configuration.
         The host copies it next to its own binary — see snoopy.microservice.host.csproj. -->
    <DocumentationFile>ApiDocumentation.xml</DocumentationFile>
    <!-- 1591: missing XML comments; nullable warnings are configured in .editorconfig -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Web SDK adds these to every ASP.NET project; this one is a library, so it spells them
         out rather than having every file re-declare what the host takes for granted. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests live in a separate assembly and exercise the internal implementations. -->
    <InternalsVisibleTo Include="snoopy.microservice.Tests" />
    <!-- The composition root (Program.cs) and the weesky platform live in their own assemblies and
         call this one's internal registration extensions and services. -->
    <InternalsVisibleTo Include="snoopy.microservice" />
    <InternalsVisibleTo Include="snoopy.providers.weesky" />
    <InternalsVisibleTo Include="snoopy.providers.weesky.Tests" />
    <!-- Moq/Castle generate their proxies into this assembly. On .NET Core, AssemblyBuilder cannot
         be strong-named at run time, so Castle emits it unsigned (PublicKeyToken=null) regardless
         of the well-known key Castle.Core ships in older guides — a PublicKey= friend declaration
         here never matches it, and every attempt to mock an internal interface throws
         TypeLoadException. Unsigned, matching an unsigned DynamicProxyGenAssembly2 and this
         (also unsigned) assembly, is what actually grants the access. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="snoopy.microservice.Tests\**" />
    <None Remove="snoopy.microservice.Tests\**" />
    <Content Remove="snoopy.microservice.Tests\**" />
    <EmbeddedResource Remove="snoopy.microservice.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CryptSharp.Core" Version="2.0.0" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="2.27.1" />
    <PackageReference Include="FolkerKinzel.VCards" Version="8.2.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.949-beta" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.17.0" />
  </ItemGroup>

</Project>
