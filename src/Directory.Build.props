<Project>
  <!-- The API's own version, read from src/scotty.microservice/VERSION; the web app has its own.
       Anything but a release build (-p:ReleaseBuild=true, set by the deploy on master) is -dev. -->
  <PropertyGroup>
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)scotty.microservice/VERSION').Trim())</VersionPrefix>
    <VersionSuffix Condition="'$(ReleaseBuild)' != 'true'">dev</VersionSuffix>
  </PropertyGroup>
</Project>
